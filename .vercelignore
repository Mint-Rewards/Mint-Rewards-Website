# What must not be uploaded by a CLI deploy.
#
# This file is the ONLY thing keeping these out. A bare `npx vercel` uploads
# the working tree as it finds it — unlike scripts/deploy.sh in the backend
# and admin API, which stage a copy first — so anything not named here goes
# to Vercel.
#
# `.env.local` is the live example: `vercel link` writes a VERCEL_OIDC_TOKEN
# into it, and it sits in the repo root.

# Credentials.
.env
.env.*
!.env.example

# Vercel's own link/state directory.
.vercel

# Version control. Vercel attributes a CLI deploy to the HEAD commit's author
# and refuses when that email is not a linked GitHub account.
.git
.github

# Build output — Vercel builds from source.
dist

# Dependencies.
node_modules

# Agent and skill working directories: screenshots, inspector reports, and
# whatever else a tool happened to leave behind.
.taste-skill
.agents
.claude
