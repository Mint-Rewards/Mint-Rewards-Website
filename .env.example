# Where the consumer backend lives. The business enquiry form POSTs to
# ${VITE_API_BASE_URL}/api/business/enquiry.
#
# This is a CROSS-ORIGIN request: the website is a static Vite build and the
# API is a separate deployment. The backend's own ALLOWED_ORIGINS must name
# this site's origin, or the browser blocks the POST and the form fails with
# a CORS error rather than a useful message.
#
# Unset, the form falls back to http://localhost:3000 for `npm run dev`,
# which the backend's ALLOWED_ORIGINS already permits via localhost:5173.
VITE_API_BASE_URL=https://api.example.com
