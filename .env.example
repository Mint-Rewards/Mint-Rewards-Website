# Where the consumer backend lives. BOTH public forms post to it:
#   contact page       -> ${VITE_API_BASE_URL}/api/contact
#   business enquiry   -> ${VITE_API_BASE_URL}/api/business/enquiry
#
# THIS MUST BE SET IN PRODUCTION. Unset, the code falls back to
# http://localhost:3000 for `npm run dev` — and a built site carries that
# fallback, so a visitor's browser posts to their OWN machine and every
# submission fails. Check a production build with:
#   grep -o 'localhost:3000' dist/assets/index-*.js
#
# It is also a CROSS-ORIGIN request: the site is a static build and the API
# a separate deployment, so the backend's ALLOWED_ORIGINS must name this
# site's origin or the browser blocks it before it leaves.
VITE_API_BASE_URL=https://api.example.com
